  "compatibility_rules": [
    {
      "id": "motor-mount-frame",
      "type": "spec_match",
      "slot_a": "frame",
      "spec_a": "motor_mount_mm",
      "slot_b": "motor",
      "spec_b": "motor_mount_mm",
      "message": "Motor mount ({b}mm) doesn't match frame ({a}mm)"
    },
    {
      "id": "battery-motor-voltage",
      "type": "range",
      "slot_a": "motor",
      "spec_a": "max_voltage_s",
      "operator": ">=",
      "slot_b": "battery",
      "spec_b": "cell_count_s",
      "message": "Motor max voltage ({a}S) is less than battery ({b}S) — risk of motor damage"
    },
    {
      "id": "esc-battery-voltage",
      "type": "range",
      "slot_a": "esc",
      "spec_a": "input_voltage_s",
      "operator": ">=",
      "slot_b": "battery",
      "spec_b": "cell_count_s",
      "message": "ESC max voltage ({a}S) is lower than battery ({b}S)"
    },
    {
      "id": "prop-frame-clearance",
      "type": "range",
      "slot_a": "frame",
      "spec_a": "prop_clearance_inch",
      "operator": ">=",
      "slot_b": "propeller",
      "spec_b": "diameter_inch",
      "message": "Propeller ({b}\") is too large for frame ({a}\" clearance)"
    },
    {
      "id": "fc-frame-stack",
      "type": "spec_match",
      "slot_a": "frame",
      "spec_a": "stack_mount_mm",
      "slot_b": "fc",
      "spec_b": "stack_mount_mm",
      "message": "FC stack mount ({b}mm) doesn't fit frame ({a}mm)"
    },
    {
      "id": "esc-frame-stack",
      "type": "spec_match",
      "slot_a": "frame",
      "spec_a": "stack_mount_mm",
